# Project Context MCP Server — configuration. Prefix: PCS_.
# Copy to `.env`. Nothing in this file is a real secret; replace values locally (FR40).

# SQLAlchemy async URL for the PostgreSQL store (D1, FR4).
# Host/dev against `just up` postgres:
PCS_DATABASE_URL=postgresql+psycopg://pcs:pcs@localhost:5432/pcs
# Inside compose the server service overrides this to @postgres:5432.

# HTTP port (NFR3). Host publish is always 127.0.0.1:${PCS_PORT}.
PCS_PORT=8080

# Access surface (FR41, NFR14, AC26):
#   localhost  — bind 127.0.0.1 only
#   tailscale  — bind the tailnet IPv4 (never 0.0.0.0 / LAN / Funnel)
PCS_BIND_MODE=localhost

# HTTP listen address for bind_mode=localhost. Empty = 127.0.0.1.
# In a container set 0.0.0.0 so Docker's published port reaches the server;
# NFR14 is enforced by the host publish being 127.0.0.1-only (B1).
PCS_BIND_ADDRESS=

# Optional explicit tailnet IPv4 when bind_mode=tailscale. Leave empty to
# use `tailscale ip -4` or the tailscale0 interface.
PCS_TAILSCALE_IP=

# Interface probed when PCS_TAILSCALE_IP is unset.
PCS_TAILSCALE_IFACE=tailscale0

# When true, the Tailscale sidecar may run `tailscale serve` for HTTPS on the
# tailnet. Funnel must stay off (NFR14).
PCS_TAILSCALE_SERVE=false

# Directory of the built web frontend (NFR13). Empty = do not serve static files.
# The server image sets this to /app/web/dist.
PCS_STATIC_DIR=

# Root level for the structured `pcs` logger (NFR6): DEBUG|INFO|WARNING|ERROR.
PCS_LOG_LEVEL=INFO

# Extra gitignore patterns (comma-separated) skipped during indexing (FR19).
PCS_INDEX_IGNORE=

# If set, only paths matching these gitignore patterns are indexed (FR19).
PCS_INDEX_ALLOW=

# Skip files larger than this many bytes (FR19).
PCS_INDEX_MAX_FILE_BYTES=1000000

# Watch registered project roots and incrementally reindex on change (FR24).
PCS_INDEX_WATCH=true

# Requirements template file (FR16a, D12). Relative -> resolved under the
# project's root_path; absolute -> used as-is. Created from a template on
# register_project if absent and kept in two-way sync with the store (D15).
PCS_REQUIREMENTS_FILE=.project-context/requirements.md

# Host paths for compose bind mounts. Relative paths are resolved from
# deploy/docker-compose.yml (so ../repos is the repo-root ./repos placeholder).
PCS_REPOS_DIR=../repos
PCS_REQUIREMENTS_DIR=../repos/.project-context

# Optional prebuilt server image. Unset = build from deploy/Dockerfile.server.
PCS_IMAGE=

# Postgres (compose). Change the password in a real deployment; not baked in the image.
POSTGRES_USER=pcs
POSTGRES_PASSWORD=pcs
POSTGRES_DB=pcs

# Tailscale overlay (deploy/docker-compose.tailscale.yml). Auth key is NEVER
# stored in the image. Create an auth key (reusable, tagged) in the admin console.
TS_AUTHKEY=
TS_HOSTNAME=pcs
TS_EXTRA_ARGS=--accept-dns=false
TS_SERVE_CONFIG=
