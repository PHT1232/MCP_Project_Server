# Multi-stage: Vite frontend + uv server. No secrets in the image (FR40).
# Bind address is decided at runtime via PCS_BIND_MODE (NFR14).

# --- frontend (Atlas Console / PCS Control Panel) ---
# node:22-slim (glibc/Debian), not -alpine: pcs-control-panel-project's
# pnpm-workspace.yaml overrides pin esbuild to the linux-x64 (glibc) binary and
# explicitly strip every other platform variant, musl included.
FROM node:22-slim AS control-panel
WORKDIR /control-panel
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
COPY pcs-control-panel-project/ ./
RUN pnpm install --frozen-lockfile
# Build-time only — the served SPA calls same-origin /api/*, so neither value
# affects runtime behavior. BASE_PATH=/ matches register_frontend's root mount.
ENV PORT=5173 BASE_PATH=/
RUN pnpm --filter @workspace/pcs-control-panel run build

# --- python deps ---
FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.11 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY server/pyproject.toml server/uv.lock server/.python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server/src ./src
COPY server/alembic.ini ./
RUN uv sync --frozen --no-dev

# --- runtime ---
FROM python:3.12-slim-bookworm
# git: the code index shells out to it for blob SHAs + incremental diffs (T03).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1000 --create-home pcs \
    && mkdir -p /var/lib/pcs/index \
    && chown pcs:pcs /var/lib/pcs/index
COPY --from=build --chown=pcs:pcs /app /app
COPY --from=control-panel /control-panel/artifacts/pcs-control-panel/dist/public /app/web/dist
COPY deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod 755 /app/entrypoint.sh
WORKDIR /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PCS_STATIC_DIR=/app/web/dist \
    PCS_BIND_MODE=localhost \
    PCS_PORT=8080
USER pcs
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
