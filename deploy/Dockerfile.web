# Optional nginx static front. Default compose serves the SPA from the server
# process (NFR13). Use this image if you want a split web container.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
# Host publish must stay 127.0.0.1 — this listen is in-container only.
EXPOSE 80
