# Project Context MCP Server — configuration (walking skeleton, T00).
# Copy to `.env`. Every var the skeleton reads is listed here. Prefix: PCS_.

# SQLAlchemy async URL for the PostgreSQL store (D1, FR4).
# Matches deploy/docker-compose.yml. Driver must be psycopg (v3).
PCS_DATABASE_URL=postgresql+psycopg://pcs:pcs@localhost:5432/pcs

# HTTP host for the streamable-HTTP MCP transport + /api routes.
# Only honoured verbatim once T08 adds tailscale binding; see PCS_BIND_MODE.
PCS_HOST=127.0.0.1

# HTTP port (NFR3).
PCS_PORT=8080

# Access surface: "localhost" binds 127.0.0.1 (NFR14). "tailscale" is a T08 seam
# and currently raises on use.
PCS_BIND_MODE=localhost

# Root level for the structured `pcs` logger (NFR6): DEBUG|INFO|WARNING|ERROR.
PCS_LOG_LEVEL=INFO

# Extra gitwildmatch patterns (comma-separated) skipped during indexing (FR19).
# Defaults already exclude secrets, vendored deps, and build output.
PCS_INDEX_IGNORE=

# If set, only paths matching these gitwildmatch patterns are indexed (FR19).
PCS_INDEX_ALLOW=

# Skip files larger than this many bytes (FR19).
PCS_INDEX_MAX_FILE_BYTES=1000000

# Watch registered project roots and incrementally reindex on change (FR24).
PCS_INDEX_WATCH=true
